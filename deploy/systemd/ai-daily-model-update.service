[Unit]
Description=Refresh AI Daily text model catalogue and evaluate eligible upgrades
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/ai-daily
EnvironmentFile=/opt/ai-daily/ai_daily_workflow/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/ai-daily/.venv/bin/python /opt/ai-daily/ai_daily_workflow/scripts/update_text_models.py --scheduled
TimeoutStartSec=30min
Restart=no
UMask=0077
Nice=10
