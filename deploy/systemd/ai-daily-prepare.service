[Unit]
Description=Generate, AI-review and automatically send today's AI Daily; notify owner on failure
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target

[Service]
Type=oneshot
User=ai-daily
Group=ai-daily
WorkingDirectory=/opt/ai-daily
EnvironmentFile=/opt/ai-daily/ai_daily_workflow/.env
Environment=PYTHONUNBUFFERED=1
# Three total attempts are persisted by the workflow; systemd must not multiply them.
ExecStart=/opt/ai-daily/.venv/bin/python /opt/ai-daily/ai_daily_workflow/scripts/run_ai_daily.py publish-reviewed --scheduled --refresh-api-content --refresh-api-image --theme digest_navy --news-layout paper
Restart=no
TimeoutStartSec=6h
UMask=0077
