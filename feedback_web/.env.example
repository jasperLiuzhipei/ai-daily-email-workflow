# Supabase server-only settings. Never expose the secret key in NEXT_PUBLIC_*.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Must match the local email packager's AI_DAILY_FEEDBACK_SECRET.
AI_DAILY_FEEDBACK_SECRET=replace-with-at-least-32-random-bytes

# Protects the analytics dashboard and delivery-sync API.
AI_DAILY_FEEDBACK_ADMIN_KEY=replace-with-a-different-strong-secret
