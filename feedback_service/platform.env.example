# Public HTTPS origin assigned by the deployment platform. Do not add a
# trailing slash. Setting this variable automatically activates feedback when
# the email package is built.
AI_DAILY_FEEDBACK_BASE_URL=https://ai-daily-feedback.example.internal

# The packager and feedback service must receive the same signing secret.
# Generate at least 32 random bytes in the platform secret manager.
AI_DAILY_FEEDBACK_SECRET=replace-in-platform-secret-manager

# Protects /admin and administrative APIs. Keep it separate from the signing
# secret and inject it only through the platform secret manager.
AI_DAILY_FEEDBACK_ADMIN_KEY=replace-in-platform-secret-manager

AI_DAILY_FEEDBACK_HOST=0.0.0.0
# Most platforms inject PORT automatically. AI_DAILY_FEEDBACK_PORT overrides it.
# AI_DAILY_FEEDBACK_PORT=8765

# Mount /data as persistent storage, otherwise redeploying loses analytics.
AI_DAILY_FEEDBACK_DB=/data/feedback.db

# Optional when the email sender can mount the local production ledger.
# Online deployments can instead receive delivery metadata through /api/delivery.
AI_DAILY_SEND_LEDGER=/runtime/send_ledger.json
