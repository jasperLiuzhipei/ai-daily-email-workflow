# Shared relay key. Keep it in the secret store or local .env, never Git.
AI_DAILY_API_KEY=

# Use this when text and image calls share one OpenAI-compatible relay.
AI_DAILY_API_BASE_URL=

# Text reasoning / editorial JSON. The default model is gpt-6-sol.
# Leave the URL empty to inherit AI_DAILY_API_BASE_URL.
AI_DAILY_TEXT_API_KEY=
AI_DAILY_TEXT_BASE_URL=
AI_DAILY_TEXT_MODEL=gpt-6-sol

# Research-image generation. The default model is gpt-image-2.
# Leave the URL empty to inherit AI_DAILY_API_BASE_URL.
AI_DAILY_IMAGE_API_KEY=
AI_DAILY_IMAGE_BASE_URL=
AI_DAILY_IMAGE_MODEL=gpt-image-2

# Optional Image2 fallback. It is used only when the primary image request
# fails. The matching config is config/ai_runtime.image_fallback.json.
AI_DAILY_IMAGE_FALLBACK_API_KEY=
AI_DAILY_IMAGE_FALLBACK_BASE_URL=
AI_DAILY_IMAGE_FALLBACK_MODEL=gpt-image-2

# Legacy fallback for older image-provider commands. New deployment commands
# use AI_DAILY_API_KEY and the two provider-specific base URLs above.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Optional alternative to --ask-password for SMTP sending.
AI_DAILY_SMTP_PASSWORD=

# Optional internal feedback service. Setting the public HTTPS origin turns on
# feedback packaging automatically. Inject secrets through the platform secret
# store and never commit them.
AI_DAILY_FEEDBACK_BASE_URL=
AI_DAILY_FEEDBACK_SECRET=
AI_DAILY_FEEDBACK_ADMIN_KEY=
AI_DAILY_FEEDBACK_DB=feedback_service/data/feedback.db
